---
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-sans-sc';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import release from '../data/release.json';

const title = 'Sniplet — 截得刚刚好。免费开源的 macOS 截图工具';
const description = 'Sniplet 是免费开源的原生 macOS 截图工具，也能轻量录屏。在选区原位标注，预设圆角、阴影、边框和背景，再复制、保存、钉图或拖出最终图像。支持延迟截图、本地文字识别和截图历史，不需要账号。';
const presets = [
  { id: 'plain', label: '原图', detail: '原图：不增加圆角、阴影或边框' },
  { id: 'soft', label: '轻柔', detail: '轻柔：圆角与淡阴影，让画面轻一点' },
  { id: 'border', label: '细框', detail: '细框：给画面一条清楚的边界' },
  { id: 'showcase', label: '展示', detail: '展示：更鲜明的留白和阴影' },
];
const features = [
  { n: '01', icon: 'crop', title: '选中，就在这里编辑。', text: '截区域、窗口或当前屏幕，工具条就在选区旁。选好后拖动四角或四边调整大小；切到选择工具，拖动画面空白处就能移动取景框。常截同一块？⌃⌥⌘4 直接重复上次区域；选好区域后，可以延迟几秒再截：选框留在原处倒计时，这期间照常操作其他 App，方便截菜单和悬停提示；也能直接改为录屏，录一段 MP4。', tags: ['原位标注', '重复上次区域', '延迟截图', '轻量录屏'] },
  { n: '02', icon: 'sparkle', title: '好看的样式，设一次。', text: '圆角、阴影、边框和背景，自由搭配。加一层纯色或渐变背景，发到微信也不会冒出白边。选好默认美化，之后的截图直接沿用，不必每张都从头调。', tags: ['四种预设', '背景', '默认美化'] },
  { n: '03', icon: 'arrow', title: '说清楚，然后发出去。', text: '箭头、矩形、画笔、文字、序号、马赛克和高亮。文字可调字号、加粗、加底色，序号自动编号。处理好的同一张最终图，可以复制、⌘S 直接存进文件夹、钉住，或拖到支持收图的应用。', tags: ['七类标注', '统一最终成图'] },
];
const faqs = [
  { q: '免费吗？有账号或订阅吗？', a: '免费，MIT 许可证开源。下载后就能使用，不需要注册账号，也没有订阅解锁或云端服务。你也可以查看源码、修改和自行构建。' },
  { q: '支持哪些 Mac？', a: '提供 Apple Silicon 与 Intel 通用构建，最低部署版本为 macOS 14。当前已在 Apple Silicon、macOS 27.0.1 上构建与验证；macOS 14 和 Intel 实机尚未单独验收。通用构建不等于所有硬件和系统组合都已测试。' },
  { q: '选完区域，还能重新取景吗？', a: '可以。选区确定后，拖动四个角或四条边调整大小；在选择工具下，拖动没有标注的画面空白处移动取景框。全屏和窗口截图也能在各自原始冻结底图的范围内调整，不会重新抓取此刻的屏幕。' },
  { q: '选区提示和图片美化是一回事吗？', a: '不是。到“设置 → 截图外观”，可以选择选区提示的颜色，以及实线、虚线或点线。它们只帮助你看清选区，不会进入输出 PNG。默认图片美化是另一项设置，控制最终图像的圆角、阴影、边框和背景。' },
  { q: '为什么需要屏幕录制权限？', a: 'macOS 把读取屏幕画面的权限叫作“屏幕录制”（新系统可能叫“录屏与系统音频录制”）。截图只抓取单帧；只有你主动开始录屏时才录视频，且不录声音。请在系统设置中选择 Applications 里的 Sniplet；若系统要求重开，请自行退出再打开。' },
  { q: '截图和识别内容会上传吗？', a: '不会。应用联网只用于检查和下载更新：读取本站的版本信息，从 GitHub 下载经签名校验的更新包；没有云同步、遥测或账号系统，也不上传截图、录屏或文字。OCR 使用本机 Vision，历史保存在本机。你主动把最终图像拖到聊天或上传区后，后续处理由接收应用决定。本官网由 Cloudflare 托管，不使用分析或广告脚本；托管方仍可能处理正常访问日志。' },
  { q: '历史和临时图片可以控制吗？', a: '可以在设置里关闭历史，已有记录不会自动删除，可以另行清空。历史只存最终图，默认最多 500 张、图片合计 1 GiB。文件型拖放会暂存最终 PNG，取消时删除，被接收后延迟 10 分钟清理；退出打断的过期清理在下次拖出时补做，不保存可恢复编辑底图。' },
  { q: '和剪贴板管理器一起用，会重复吗？', a: '功能开关由你决定：可以关闭 OCR，也可以选择为复制内容添加临时类型标记，供支持这一约定的剪贴板工具过滤。是否收录取决于对方设置。Sniplet 不检测或联动其他应用。' },
  { q: '遇到问题，去哪里反馈？', a: '到 GitHub Issues 描述 macOS 版本、Sniplet 版本和复现步骤即可。不方便截图时，用文字描述也可以。不要上传私人截图、敏感文字或完整个人日志。' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9f6" />
    <link rel="canonical" href="https://sniplet.elazer.wang/" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Sniplet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://sniplet.elazer.wang/" />
    <meta property="og:image" content="https://sniplet.elazer.wang/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sniplet：截得刚刚好。免费开源的 macOS 截图工具，配图为合成界面示意。" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://sniplet.elazer.wang/og.png" />
    <meta name="twitter:image:alt" content="Sniplet 截图工具宣传图，含合成界面示意。" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="announcement"><a href={release.release}><span class="status-dot"></span> Sniplet {release.version} 已发布 <span class="announcement-separator">/</span> 免费，也开源 <Icon name="arrow" size={13}/></a></div>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Sniplet 首页"><img src="/icon.png" alt="" width="36" height="36"/><span>Sniplet<span class="brand-period">.</span></span></a>
      <button class="nav-toggle" aria-label="打开导航" aria-expanded="false" aria-controls="navigation"><Icon name="menu"/></button>
      <nav id="navigation" aria-label="主导航">
        <a href="#features">小而够用</a><a href="#start">开始使用</a><a href="#faq">常见问题</a>
        <a class="nav-source" href={release.repository}>GitHub <Icon name="arrow" size={14}/></a>
      </nav>
      <a class="nav-download" href={release.download}>下载 macOS 版 <Icon name="down" size={15}/></a>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-line"></span> 一个原生的 macOS 小工具</div>
          <h1 id="hero-title">把想说的，<br/><span>截得刚刚好。</span></h1>
          <p class="hero-description">截图、标注、美化，然后发出去。<br/>留在菜单栏里，让截图这件小事，少绕几步。</p>
          <div class="hero-actions"><a class="button button-dark" href={release.download}><Icon name="apple" size={21}/>下载 Sniplet <Icon name="down" size={17}/></a><a class="source-link" href={release.repository}>看看源代码 <Icon name="arrow" size={17}/></a></div>
          <p class="download-meta">v{release.version}<span>·</span>macOS 14+<span>·</span>Apple Silicon & Intel</p>
          <div class="shortcut"><span>从一个快捷键开始</span><div aria-label="Shift Command A"><kbd>⇧</kbd><kbd>⌘</kbd><kbd>A</kbd></div></div>
        </div>
        <figure class="hero-product" aria-label="截图美化交互示意">
          <div class="product-stage" data-preset="soft">
            <div class="stage-grid" aria-hidden="true"></div>
            <div class="stage-topline" aria-hidden="true"><span><Icon name="crop" size={15}/>你的下一张截图</span><span class="mono">720 × 480</span></div>
            <div class="sample-selection">
              <div class="sample-image" aria-hidden="true">
                <div class="sample-window-bar"><span class="window-dots"><i></i><i></i><i></i></span><span>一则便笺</span><Icon name="square" size={12}/></div>
                <div class="sample-note"><div class="note-kicker">A LITTLE NOTE TO SELF</div><div class="note-title">好想法，<br/>值得<span class="marked-word">被看见<svg viewBox="0 0 180 15" fill="none"><path d="M3 10C46 1 113 2 175 8M7 13c45-4 96-3 151 0" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg></span>。</div><p>用一张清楚的截图，<br/>把脑海里的那句话，分享出去。</p><div class="note-bottom"><span class="note-dot"></span> Capture a little. Say a lot.<span>↗</span></div></div>
              </div>
              <div class="selection-outline" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
              <div class="demo-side-tools" aria-hidden="true"><Icon name="down" size={17}/><Icon name="pin" size={17}/><Icon name="text" size={17}/><span></span><Icon name="check" size={17}/></div>
              <div class="demo-bottom-tools" aria-hidden="true"><Icon name="move" size={17}/><Icon name="arrow" size={17}/><Icon name="square" size={17}/><Icon name="pen" size={17}/><Icon name="text" size={17}/><Icon name="counter" size={17}/><Icon name="mosaic" size={17}/><Icon name="highlight" size={17}/><span></span><Icon name="sparkle" size={17}/><Icon name="undo" size={17}/></div>
            </div>
            <div class="stage-bottomline" aria-hidden="true"><span class="tiny-cross">+</span><span>就在选区旁。无需另开编辑窗口。</span><span class="tiny-cross">+</span></div>
          </div>
          <div class="preset-bar"><span class="preset-caption"><Icon name="sparkle" size={15}/>试试美化</span><div class="preset-options" role="group" aria-label="示意图的美化预设">{presets.map((preset) => <button type="button" data-style={preset.id} data-description={preset.detail} aria-pressed={preset.id === 'soft'}>{preset.label}</button>)}</div></div>
          <figcaption><span class="demo-label">交互示意</span><span id="preset-status" aria-live="polite">轻柔：圆角与淡阴影，让画面轻一点</span></figcaption>
        </figure>
      </section>
      <div class="values-strip wrap"><span><Icon name="apple" size={17}/>原生 Swift / AppKit</span><span><Icon name="shield" size={17}/>联网只为检查更新</span><span><Icon name="code" size={17}/>MIT 许可证开源</span></div>
      <section id="features" class="features wrap section-space" aria-labelledby="features-title">
        <div class="section-heading"><div><p class="eyebrow">LESS FRICTION. MORE CLARITY.</p><h2 id="features-title">截完，就把事情说明白。</h2></div><p>不需要一整套创作软件。<br/>需要的时候，刚好够用。</p></div>
        <div class="feature-columns">{features.map((feature) => <article class="feature"><div class="feature-top"><span class="mono">/{feature.n}</span><Icon name={feature.icon} size={26}/></div><h3>{feature.title}</h3><p>{feature.text}</p><div class="feature-tags">{feature.tags.map(tag => <span>{tag}</span>)}</div></article>)}</div>
      </section>
      <section class="local-section" aria-labelledby="local-title"><div class="wrap local-grid"><div class="local-copy"><p class="eyebrow"><span class="status-dot"></span> LOCAL, BY DESIGN</p><h2 id="local-title">画面留在本机。<br/><span>决定权也一样。</span></h2><p>不需要账号，不自带云端。<br/>截图、识别和整理，都在你的 Mac 上完成。</p><a href="#faq">了解数据与权限 <Icon name="arrow" size={16}/></a><div class="local-mark" aria-hidden="true"><Icon name="crop" size={116}/><i></i></div></div><div class="local-features"><article><span class="local-icon"><Icon name="text" size={23}/></span><div><h3>看得见，也能读出来。</h3><p>本机 Vision 识别中文与英文。识别的是处理后的最终图，而不是打码前的底图。</p></div></article><article><span class="local-icon"><Icon name="pin" size={23}/></span><div><h3>参考图，留在手边。</h3><p>钉住最终图像，独立缩放。对照文档、数据和设计，不用在窗口之间反复找图。</p></div></article><article><span class="local-icon"><Icon name="history" size={23}/></span><div><h3>要找的时候，还找得到。</h3><p>本地历史支持日期、文件名和已完成的 OCR 文字搜索。可以关闭历史，也可以明确清空。</p></div></article></div></div></section>
      <section id="start" class="start-section wrap section-space" aria-labelledby="start-title"><div class="section-heading"><div><p class="eyebrow">MAKE YOURSELF AT HOME.</p><h2 id="start-title">下一张截图，从这里开始。</h2></div><a class="text-link" href={release.download}>下载 v{release.version}<Icon name="down" size={17}/></a></div><ol class="start-steps"><li><span class="step-number mono">01</span><h3>放进 Applications</h3><p>打开下载的 DMG，将 Sniplet 拖进“应用程序”。启动后，在菜单栏找 Sniplet 的选框图标。</p></li><li><span class="step-number mono">02</span><h3>允许它看见屏幕</h3><p>首次截图时，按系统提示授予屏幕录制权限。截图只取单帧；录屏只在你主动开始时进行，不录声音。</p></li><li><span class="step-number mono">03</span><h3>按下 <span class="inline-shortcut">⇧ ⌘ A</span></h3><p>选中、标注、完成。到设置里选好默认美化，下一张就不用再调。</p></li></ol></section>
      <section id="faq" class="faq-section wrap section-space" aria-labelledby="faq-title"><div class="faq-heading"><p class="eyebrow">A FEW GOOD QUESTIONS.</p><h2 id="faq-title">先回答<br/>你可能想问的。</h2><a class="text-link" href={`${release.repository}/issues`}>还有问题？去 GitHub <Icon name="arrow" size={16}/></a></div><div class="faq-list">{faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>
      <section class="closing wrap" aria-labelledby="closing-title"><div><span class="eyebrow">SMALL TOOL. CLEARER THOUGHTS.</span><h2 id="closing-title">少一点折腾。<br/>多一点清楚。</h2></div><div class="closing-actions"><a class="button button-dark" href={release.download}><Icon name="apple" size={22}/>免费获取 Sniplet<Icon name="down" size={18}/></a><p>macOS 14+ · 免费开源 · 无需账号</p><a class="text-link small" href={release.release}>发布说明与校验值 <Icon name="arrow" size={14}/></a></div><span class="closing-crop" aria-hidden="true"><Icon name="crop" size={200}/></span></section>
    </main>
    <footer class="wrap site-footer"><a class="brand footer-brand" href="/"><img src="/icon.png" alt="" width="28" height="28"/><span>Sniplet.</span></a><p>一个把截图这件小事做简单的工具。</p><div><a href={release.repository}>源代码</a><a href={`${release.repository}/blob/main/LICENSE`}>MIT 许可证</a><a href={`${release.repository}/issues`}>反馈</a></div><span class="footer-credit">© 2026 Elazer</span></footer>
    <script>
      document.documentElement.classList.add('js');
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const navigation = document.querySelector<HTMLElement>('#navigation');
      const closeNavigation = () => { toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', '打开导航'); navigation?.classList.remove('is-open'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? '关闭导航' : '打开导航');
        navigation?.classList.toggle('is-open', open);
      });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeNavigation));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { closeNavigation(); toggle.focus(); }
      });
      const stage = document.querySelector<HTMLElement>('.product-stage');
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-style]'));
      const status = document.querySelector('#preset-status');
      const applyPreset = (button: HTMLButtonElement) => {
        if (stage) stage.dataset.preset = button.dataset.style;
        buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        if (status) status.textContent = button.dataset.description ?? '';
      };
      buttons.forEach((button, index) => {
        button.addEventListener('click', () => applyPreset(button));
        button.addEventListener('keydown', event => {
          if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
          buttons[next].focus(); applyPreset(buttons[next]);
        });
      });
    </script>
  </body>
</html>
