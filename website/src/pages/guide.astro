---
import '@fontsource-variable/manrope';
import '@fontsource-variable/noto-sans-sc';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import release from '../data/release.json';
import { sections } from '../data/guide';

const title = '使用指南 — Sniplet';
const description = 'Sniplet 使用指南：第一次打开、截图、标注、复制保存与拖出、录屏与延迟截图、钉图、历史与文字识别、快捷键一览和常见问题。';
const url = 'https://sniplet.elazer.wang/guide/';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9f6" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content="Sniplet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content="https://sniplet.elazer.wang/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <SiteHeader />
    <main id="main" class="guide wrap">
      <div class="guide-intro">
        <p class="eyebrow"><span class="eyebrow-line"></span> HOW IT WORKS.</p>
        <h1>使用指南</h1>
        <p>App 里的菜单栏「使用指南…」是同一份说明，截图时按 <kbd>?</kbd> 还能随时查看编辑快捷键。</p>
      </div>
      <div class="guide-layout">
        <nav class="guide-toc" aria-label="指南目录">
          <ol>{sections.map(section => <li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol>
        </nav>
        <div class="guide-body">
          {sections.map(section => (
            <section id={section.id} aria-labelledby={`${section.id}-title`}>
              <h2 id={`${section.id}-title`}>{section.title}</h2>
              {section.blocks.map(block => {
                if (block.kind === 'text') return <p>{block.text}</p>;
                if (block.kind === 'list') return <ol class="guide-steps">{block.items.map(item => <li>{item}</li>)}</ol>;
                if (block.kind === 'question') return <div class="guide-question"><h3>{block.q}</h3><p>{block.a}</p></div>;
                return (
                  <div class="guide-shortcuts">
                    {block.title && <h3>{block.title}</h3>}
                    <table>
                      <tbody>{block.items.map(item => <tr><th scope="row"><kbd>{item.keys}</kbd></th><td>{item.meaning}</td></tr>)}</tbody>
                    </table>
                  </div>
                );
              })}
            </section>
          ))}
          <p class="guide-more">没找到答案？<a class="text-link" href={`${release.repository}/issues`}>到 GitHub 反馈 <Icon name="arrow" size={14}/></a></p>
        </div>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
